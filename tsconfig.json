{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@nativescript/types"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "cli/**/*.mjs", "bin/**/*.mjs"],
  "exclude": ["dist", "playground/**"]
}
