{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "paths": {
      "vue": [
        "./node_modules/nativescript-vue"
      ]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.vue",
    ".nuxt-native/**/*.js",
    ".nuxt-native/**/*.mjs",
    ".nuxt-native/**/*.vue",
    ".nuxt-native/**/*.d.ts"
  ]
}
