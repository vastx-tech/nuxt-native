{
  "name": "nuxt-native",
  "version": "0.1.0",
  "description": "Build real native Android apps with Nuxt and Vue — no WebView. A Flutter/React Native-style framework for the Nuxt ecosystem, powered by NativeScript's native runtime. Android is verified on real hardware; iOS support exists but is experimental (unverified on-device).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime/*": "./dist/runtime/*",
    "./cli/*": "./cli/*"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "bin": {
    "nuxt-native": "./bin/nuxt-native.mjs"
  },
  "files": [
    "dist",
    "bin",
    "cli",
    "!cli/tests",
    "STYLING.md",
    "mcp-server/bin",
    "mcp-server/src",
    "mcp-server/README.md"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "prepare": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "native:init": "node ./bin/nuxt-native.mjs init",
    "native:dev:ios": "node ./bin/nuxt-native.mjs dev ios",
    "native:dev:android": "node ./bin/nuxt-native.mjs dev android",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test cli/tests/styling.test.mjs cli/tests/ios-infoplist-fix.test.mjs mcp-server/packaged-cli.test.mjs",
    "test:mcp": "node --test mcp-server/packaged-cli.test.mjs",
    "test:styling": "node --test cli/tests/styling.test.mjs",
    "test:ios-infoplist": "node --test cli/tests/ios-infoplist-fix.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nativescript/tailwind": "4.0.10",
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4",
    "postcss-value-parser": "4.2.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@nativescript/core": "^9.0.0",
    "nativescript-vue": "^3.0.0",
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@nativescript/camera": "^7.0.0",
    "@nativescript/core": "^9.1.2",
    "@nativescript/geolocation": "^9.0.0",
    "@nativescript/types": "^9.1.1",
    "@nativescript/webpack": "~5.0.38",
    "@nuxt/eslint-config": "^1.0.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "nativescript": "^9.1.1",
    "nativescript-vue": "^3.1.2",
    "nuxt": "^4.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0"
  }
}
